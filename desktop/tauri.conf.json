{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wit",
  "version": "0.1.1",
  "identifier": "app.wit.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "Cosmin Stefaniga",
    "copyright": "© 2026 Cosmin Stefaniga",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../web/dist/": "web/",
      "../fonts/*.ttf": "fonts/",
      "../fonts/README.md": "fonts/README.md",
      "../fonts/licenses/": "fonts/licenses/"
    }
  }
}
